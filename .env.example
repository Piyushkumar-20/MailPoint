# Razorpay billing (required by the current environment schema)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Set to true only for builds that intentionally skip environment validation.
